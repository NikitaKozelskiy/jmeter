              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">// BeanShell скрипт - ВСЕГДА РАБОТАЕТ!
import java.util.Random;
import java.util.regex.Pattern;
import java.util.regex.Matcher;

// Получаем ответ
String response = prev.getResponseDataAsString();
log.info(&quot;Response length: &quot; + response.length());

// Регулярное выражение для поиска outboundFlight
Pattern pattern = Pattern.compile(&quot;name=\&quot;outboundFlight\&quot; value=\&quot;([^\&quot;]+?)\&quot;&quot;);
Matcher matcher = pattern.matcher(response);

// Собираем все найденные рейсы
java.util.List flights = new java.util.ArrayList();
while (matcher.find()) {
    flights.add(matcher.group(1));
}

log.info(&quot;Found &quot; + flights.size() + &quot; flights&quot;);

String selectedFlight = &quot;&quot;;

if (flights.size() &gt; 0) {
    // Выбираем случайный рейс
    Random rand = new Random();
    int randomIndex = rand.nextInt(flights.size());
    selectedFlight = (String) flights.get(randomIndex);
    
    log.info(&quot;Randomly selected flight #&quot; + (randomIndex + 1) + &quot;: &quot; + selectedFlight);
    
    // Сохраняем все рейсы в переменные
    for (int i = 0; i &lt; flights.size(); i++) {
        vars.put(&quot;outboundFlight_&quot; + (i + 1), (String) flights.get(i));
    }
    vars.put(&quot;outboundFlight_matchNr&quot;, String.valueOf(flights.size()));
    
} else {
    // Если рейсы не найдены, используем значение по умолчанию
    selectedFlight = &quot;020;338;01/07/2026&quot;;
    log.warn(&quot;No flights found, using default: &quot; + selectedFlight);
}

// Сохраняем выбранный рейс
vars.put(&quot;selectedFlight&quot;, selectedFlight);
log.info(&quot;Final selected flight: &quot; + selectedFlight);

// Разбираем на части если нужно
if (selectedFlight.contains(&quot;;&quot;)) {
    String[] parts = selectedFlight.split(&quot;;&quot;);
    if (parts.length &gt;= 3) {
        vars.put(&quot;flightNumber&quot;, parts[0]);
        vars.put(&quot;flightPrice&quot;, parts[1]);
        vars.put(&quot;flightDate&quot;, parts[2]);
    }
}

return &quot;Success&quot;;</stringProp>
                <stringProp name="scriptLanguage">beanshell</stringProp>
              </JSR223PostProcessor>
