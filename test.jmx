              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
                <stringProp name="scriptLanguage">beanshell</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// BeanShell - выбор случайных городов
import java.util.Random;

log.info(&quot;=== SELECTING RANDOM CITIES ===&quot;);

// 1. Получаем количество городов для depart
String departCountStr = vars.get(&quot;departCity_matchNr&quot;);
String arriveCountStr = vars.get(&quot;arriveCity_matchNr&quot;);

log.info(&quot;Depart cities found: &quot; + departCountStr);
log.info(&quot;Arrive cities found: &quot; + arriveCountStr);

// 2. Выбираем случайный город вылета
String randomDepartCity = &quot;Denver&quot;; // значение по умолчанию
if (departCountStr != null &amp;&amp; !departCountStr.equals(&quot;0&quot;)) {
    try {
        int departCount = Integer.parseInt(departCountStr);
        if (departCount &gt; 0) {
            Random rand = new Random();
            int randomIndex = rand.nextInt(departCount) + 1;
            randomDepartCity = vars.get(&quot;departCity_&quot; + randomIndex);
            log.info(&quot;Random depart city #&quot; + randomIndex + &quot;: &quot; + randomDepartCity);
        }
    } catch (Exception e) {
        log.error(&quot;Error selecting depart city: &quot; + e.getMessage());
    }
}

// 3. Выбираем случайный город прилета (не такой же как вылет)
String randomArriveCity = &quot;London&quot;; // значение по умолчанию
if (arriveCountStr != null &amp;&amp; !arriveCountStr.equals(&quot;0&quot;)) {
    try {
        int arriveCount = Integer.parseInt(arriveCountStr);
        if (arriveCount &gt; 0) {
            Random rand = new Random();
            String tempCity;
            int attempts = 0;
            
            // Пытаемся выбрать город отличный от вылета
            do {
                int randomIndex = rand.nextInt(arriveCount) + 1;
                tempCity = vars.get(&quot;arriveCity_&quot; + randomIndex);
                attempts++;
                
                // Если города разные или много попыток - выходим
                if (!tempCity.equals(randomDepartCity) || attempts &gt; 10) {
                    randomArriveCity = tempCity;
                    break;
                }
            } while (true);
            
            log.info(&quot;Random arrive city: &quot; + randomArriveCity + &quot; (after &quot; + attempts + &quot; attempts)&quot;);
        }
    } catch (Exception e) {
        log.error(&quot;Error selecting arrive city: &quot; + e.getMessage());
    }
}

// 4. Сохраняем выбранные города
vars.put(&quot;selectedDepartCity&quot;, randomDepartCity);
vars.put(&quot;selectedArriveCity&quot;, randomArriveCity);

log.info(&quot;=== FINAL SELECTION ===&quot;);
log.info(&quot;Depart: &quot; + randomDepartCity);
log.info(&quot;Arrive: &quot; + randomArriveCity);</stringProp>
              </JSR223PostProcessor>
